# Storage
STORE_BACKEND=redis                  # redis | memory
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
REDIS_KEY_PREFIX=vera:

# LLM
LLM_MODE=live                        # live | mock
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
PRIMARY_MODEL=openai/gpt-oss-120b
SECONDARY_MODEL=openai/gpt-oss-20b
ALT_PROVIDER_NAME=
ALT_BASE_URL=
ALT_API_KEY=
ALT_MODEL=
MODEL_RPM=30
MODEL_TPM=8000
MODEL_RPD=1000
MODEL_TPD=200000
LLM_CALL_TIMEOUT_S=12
LLM_SEED=7

# Budgets (keep <= vercel.json maxDuration - 5)
TICK_DEADLINE_S=20
REPLY_DEADLINE_S=15
MAX_ACTIONS_PER_TICK=20

# Metadata
TEAM_NAME=Sobhan
TEAM_MEMBERS=Sobhan
CONTACT_EMAIL=
BOT_VERSION=1.0.0
SUBMITTED_AT=
DEBUG_TOKEN=

# 200 = idempotent no-op on same version (testing brief); 409 = api-call-examples 1.5
SAME_VERSION_STATUS=200
