# Copy to .env and fill in. .env is git-ignored; NEVER put real keys in this file (it is committed).
# Storage
STORE_BACKEND=redis                  # redis | memory
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
REDIS_KEY_PREFIX=vera:

# LLM
LLM_MODE=live                        # live | mock
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
PRIMARY_MODEL=openai/gpt-oss-120b
SECONDARY_MODEL=openai/gpt-oss-20b
# Independent second provider (Cerebras): third model in the failover chain
ALT_PROVIDER_NAME=cerebras
ALT_BASE_URL=https://api.cerebras.ai/v1
ALT_API_KEY=
ALT_MODEL=gpt-oss-120b
ALT_JSON_MODE=schema                 # object | schema (schema = strict structured output; use it if the provider supports it)
ALT_MODEL_RPM=30                     # free-tier limits of the alternate provider (default = MODEL_*); check its console
ALT_MODEL_TPM=8000
ALT_MODEL_RPD=1000
ALT_MODEL_TPD=200000
# Free-tier limits per model (Groq free plan for the gpt-oss models)
MODEL_RPM=30
MODEL_TPM=8000
MODEL_RPD=1000
MODEL_TPD=200000
LLM_CALL_TIMEOUT_S=12
LLM_SEED=7
LLM_BATCH_SIZE=3                     # decisions composed per LLM call (1 = one call per message, max 4); best-scored decisions get the quota first

# Budgets (keep <= vercel.json maxDuration - 5)
TICK_DEADLINE_S=20
REPLY_DEADLINE_S=15
MAX_ACTIONS_PER_TICK=20

# Metadata
TEAM_NAME=Sobhan
TEAM_MEMBERS=Sobhan
CONTACT_EMAIL=
BOT_VERSION=1.0.0
SUBMITTED_AT=
DEBUG_TOKEN=

# lenient (default) = a customer with ANY active opt-in scope is contacted; only missing consent or an opt-out blocks a send.
# strict = the scope must also cover the trigger kind (recall_reminders for recall_due ...). The generated dataset gives every
# generated customer only ["promotional_offers"], so strict would skip ~25% of generated customer triggers.
CONSENT_MODE=lenient
