# Copy to .env and fill in. .env is git-ignored; NEVER put real keys in this file (it is committed).
# Storage
STORE_BACKEND=redis                  # redis | memory
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
REDIS_KEY_PREFIX=vera:

# LLM
LLM_MODE=live                        # live | mock
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
PRIMARY_MODEL=openai/gpt-oss-120b
SECONDARY_MODEL=openai/gpt-oss-20b
# Optional independent OpenAI-compatible provider (e.g. Cerebras: https://api.cerebras.ai/v1, model gpt-oss-120b)
ALT_PROVIDER_NAME=
ALT_BASE_URL=
ALT_API_KEY=
ALT_MODEL=
ALT_JSON_MODE=object                 # object | schema (schema = strict structured output; use it if the provider supports it)
ALT_MODEL_RPM=30                     # free-tier limits of the alternate provider (default = MODEL_*); check its console
ALT_MODEL_TPM=8000
ALT_MODEL_RPD=1000
ALT_MODEL_TPD=200000
# Free-tier limits per model (Groq free plan for the gpt-oss models)
MODEL_RPM=30
MODEL_TPM=8000
MODEL_RPD=1000
MODEL_TPD=200000
LLM_CALL_TIMEOUT_S=12
LLM_SEED=7
LLM_BATCH_SIZE=1                     # 1 = one LLM call per message; 2-4 = batch decisions per call

# Budgets (keep <= vercel.json maxDuration - 5)
TICK_DEADLINE_S=20
REPLY_DEADLINE_S=15
MAX_ACTIONS_PER_TICK=20

# Metadata
TEAM_NAME=Sobhan
TEAM_MEMBERS=Sobhan
CONTACT_EMAIL=
BOT_VERSION=1.0.0
SUBMITTED_AT=
DEBUG_TOKEN=

# 200 = idempotent no-op on same version (testing brief); 409 = api-call-examples 1.5
SAME_VERSION_STATUS=200

# strict = a customer's consent scope must cover the trigger kind (recall_reminders for recall_due ...).
# lenient = any active consent is enough. The generated dataset gives every generated customer only ["promotional_offers"],
# so strict silently skips ~25% of generated customer triggers.
CONSENT_MODE=strict
